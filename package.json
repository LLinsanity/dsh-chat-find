{
  "name": "dsh-chat-find",
  "version": "0.1.0",
  "description": "Ctrl+F find bar for the current conversation: matches your messages and replies, highlights them without touching the DOM, jumps between matches, and loads earlier history on demand.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./assets/*": "./assets/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "screenshots.json",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-shortcuts",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "find",
    "search",
    "chat",
    "conversation",
    "ctrl+f",
    "highlight",
    "查找",
    "搜索",
    "对话"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-0 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLinsanity/dsh-chat-find.git"
  },
  "homepage": "https://github.com/LLinsanity/dsh-chat-find#readme",
  "bugs": {
    "url": "https://github.com/LLinsanity/dsh-chat-find/issues"
  }
}
